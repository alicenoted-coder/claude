# ── YouTube ──────────────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > API Key
# 啟用 YouTube Data API v3
YOUTUBE_API_KEY=

# ── Facebook ─────────────────────────────────────────────────────────────────
# Meta Developers > App > User Token / Page Token
# 權限需要：pages_read_engagement, pages_read_user_content, pages_show_list
FACEBOOK_ACCESS_TOKEN=

# ── Instagram ─────────────────────────────────────────────────────────────────
# Meta Developers > App > Instagram Graph API
# 需先綁定 Facebook Page，取得 Instagram Business Account ID
# 權限需要：instagram_basic, instagram_manage_comments
INSTAGRAM_ACCESS_TOKEN=

# ── Threads ───────────────────────────────────────────────────────────────────
# Meta Developers > App > Threads API（與 IG 共用 App）
# 權限需要：threads_basic, threads_manage_replies
THREADS_ACCESS_TOKEN=
